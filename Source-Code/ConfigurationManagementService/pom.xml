<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.walmart.cms</groupId>
    <artifactId>enterprise-cms</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Enterprise Configuration Management System</name>
    <modules>
        <module>cms-dal</module>
        <module>cms-cache</module>
        <module>cms-core-api</module>
        <module>cms-config-api</module>
        <module>cms-deployment-api</module>
        <module>cms-management-api</module>
        <module>cms-security</module>
        <module>cms-app</module>
        <module>cms-clientsdk</module>
        <module>cms-cli-consumer</module>
    </modules>

    <properties>
        <java.version>21</java.version>
    </properties>

    <!-- Manage versions of internal CMS modules -->
    <dependencyManagement>
        <dependencies>

            <dependency>
                <groupId>com.walmart.cms</groupId>
                <artifactId>cms-dal</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.walmart.cms</groupId>
                <artifactId>cms-cache</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.walmart.cms</groupId>
                <artifactId>cms-core-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.walmart.cms</groupId>
                <artifactId>cms-config-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.walmart.cms</groupId>
                <artifactId>cms-deployment-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.walmart.cms</groupId>
                <artifactId>cms-management-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.walmart.cms</groupId>
                <artifactId>cms-security</artifactId>
                <version>${project.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>
</project>